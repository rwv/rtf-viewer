{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": [],
    "ignoreDeprecations": "6.0",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "examples/*/src/**/*.ts"
  ],
  "exclude": [
    "packages/*/src/parser.worker.ts",
    "tests/consumer",
    "packages/*/src/**/*.test.ts"
  ]
}
